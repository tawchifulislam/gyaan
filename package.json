{
  "name": "gyaan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-article research assistant for a Bengali knowledge blog (retrieval-augmented generation with a measured evaluation).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "export": "tsx scripts/export-corpus.ts",
    "chunks": "tsx scripts/build-chunks.ts",
    "validate": "tsx scripts/validate-eval.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "bench": "tsx scripts/benchmark.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:local": "tsx scripts/db-migrate.ts --local",
    "db:check": "tsx scripts/db-check.ts",
    "db:check:local": "tsx scripts/db-check.ts --local",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:local": "tsx scripts/ingest.ts --local",
    "search": "tsx scripts/search.ts",
    "search:local": "tsx scripts/search.ts --local",
    "answers": "tsx scripts/answer-eval.ts",
    "answers:local": "tsx scripts/answer-eval.ts --local"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
