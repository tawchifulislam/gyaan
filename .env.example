TFK_API_URL=https://your-blog-server.example.com
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Voyage accounts without a payment method are limited to 3 requests/min and 10K tokens/min.
# The benchmark paces itself to that by default. If you add a payment method, raise them:
# VOYAGE_RPM=300
# VOYAGE_TPM=1000000
DATABASE_URL=

# Optional. The answer model gemini-3.1-flash-lite allows 15 requests/min on the free tier;
# Gyaan paces itself at 12. Raise this if your limit is higher.
# GEMINI_GEN_RPM=12
# Optional, only if the model supports it (e.g. minimal or low). Leave unset by default.
# GEMINI_THINKING_LEVEL=
